<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".DocumentsActivity">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Documents"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1E88E5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Uploaded documents for trips, IDs, and receipts."
                android:textSize="12sp"
                android:textColor="#444444"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnUpload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:backgroundTint="#2196F3"
            android:drawableStart="@drawable/ic_upload"
            android:drawablePadding="4dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"/>
    </LinearLayout>

    <!-- Tabs Section -->
    <HorizontalScrollView
        android:id="@+id/tabScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerSection">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <Button
                android:id="@+id/tabParticipants"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Participants"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#2196F3"
                android:backgroundTint="#FFFFFF"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/tabPolls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Polls"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#2196F3"
                android:backgroundTint="#FFFFFF"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/tabExpenses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expenses"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#2196F3"
                android:backgroundTint="#FFFFFF"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/tabDocs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Docs"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2196F3"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/tabItinerary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Itinerary"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#2196F3"
                android:backgroundTint="#FFFFFF"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main ScrollView for Photos -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/tabScroll"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Documents"
                android:textStyle="bold"
                android:textColor="#1E88E5"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <!-- Grid-style Image layout -->
            <GridLayout
                android:id="@+id/gridDocuments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="3"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false"
                android:rowOrderPreserved="false"
                android:useDefaultMargins="true">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sample_doc1"
                    android:layout_margin="4dp"
                    android:background="@drawable/rounded_card_bg"/>

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sample_doc2"
                    android:layout_margin="4dp"
                    android:background="@drawable/rounded_card_bg"/>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sample_doc3"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/rounded_card_bg"
                    android:layout_columnSpan="2"/>

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sample_doc4"
                    android:layout_margin="4dp"
                    android:background="@drawable/rounded_card_bg"/>

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sample_doc5"
                    android:layout_margin="4dp"
                    android:background="@drawable/rounded_card_bg"/>
            </GridLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:itemIconTint="@color/nav_item_selector"
        app:itemTextColor="@color/nav_item_selector"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
