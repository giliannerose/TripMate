<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".ProfileSetupActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set up your profile"
                android:textStyle="bold"
                android:textColor="#2196F3"
                android:textSize="20sp"
                android:layout_marginBottom="4dp"/>

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add a photo and fill in your details so your travel buddies can recognize you ✈️"
                android:textColor="#444444"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="20dp"
                android:paddingHorizontal="16dp"/>

            <!-- Profile Image -->
            <ImageView
                android:id="@+id/imgProfile"
                android:layout_width="100px"
                android:layout_height="100px"
                android:background="@drawable/profile_image_bg"
                android:scaleType="centerCrop"
                android:contentDescription="Profile photo"
                android:src="@drawable/ic_add_photo"
                android:layout_marginBottom="20dp"/>

            <!-- Name Input -->
            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Name"
                android:background="@drawable/edittext_bg"
                android:padding="12dp"
                android:inputType="textPersonName"
                android:layout_marginBottom="12dp"/>

            <!-- Bio Input -->
            <EditText
                android:id="@+id/etBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Bio"
                android:background="@drawable/edittext_bg"
                android:padding="12dp"
                android:inputType="textMultiLine"
                android:lines="2"
                android:layout_marginBottom="12dp"/>

            <!-- Location Input -->
            <EditText
                android:id="@+id/etLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Location"
                android:background="@drawable/edittext_bg"
                android:padding="12dp"
                android:inputType="textPostalAddress"
                android:layout_marginBottom="24dp"/>

            <!-- Save Changes Button -->
            <Button
                android:id="@+id/btnSaveChanges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Changes"
                android:textColor="#FFFFFF"
                android:background="@drawable/rounded_button_primary"
                android:layout_marginBottom="12dp"/>

            <!-- Skip Button -->
            <Button
                android:id="@+id/btnSkip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Skip"
                android:textColor="#2196F3"
                android:background="@drawable/rounded_button_secondary"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
