<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notifications"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1E88E5"/>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_notifications"
                    app:tint="#1E88E5"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="All recent activity: invites, polls, expenses, and system alerts."
                android:textColor="#555555"
                android:textSize="13sp"
                android:layout_marginBottom="16dp"/>

            <!-- Notification Card 1: Invitation -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Eva sent an invitation"
                        android:textStyle="bold"
                        android:textColor="#000"
                        android:textSize="15sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Details:"
                        android:textColor="#333"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trip Name: Summer Trip\nLocation: Paris, France\nDate: July 13–15"
                        android:textColor="#555"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnAccept"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Accept"
                            android:backgroundTint="#2196F3"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:layout_marginEnd="6dp"/>

                        <Button
                            android:id="@+id/btnDecline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Decline"
                            android:backgroundTint="#F44336"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Notification Card 2: Poll -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New Poll: What's your favorite season?"
                        android:textStyle="bold"
                        android:textColor="#000"
                        android:textSize="15sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Options: Summer, Spring, Winter, Fall"
                        android:textColor="#555"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp"/>

                    <Button
                        android:id="@+id/btnViewPoll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View Poll"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#2196F3"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Notification Card 3: Expense -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expense Added: Tours"
                        android:textStyle="bold"
                        android:textColor="#000"
                        android:textSize="15sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Amount: ₱4,297 per person"
                        android:textColor="#555"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp"/>

                    <Button
                        android:id="@+id/btnViewExpenses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View Expenses"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#2196F3"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Notification Card 4: System Maintenance -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:backgroundTint="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="System Maintenance Schedule"
                        android:textStyle="bold"
                        android:textColor="#000"
                        android:textSize="15sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Inviting members will not be available until Mon, 09/22/2025."
                        android:textColor="#555"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp"/>

                    <Button
                        android:id="@+id/btnAcknowledge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Acknowledge"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#2196F3"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:itemIconTint="@color/nav_item_selector"
        app:itemTextColor="@color/nav_item_selector"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
