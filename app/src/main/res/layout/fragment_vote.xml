<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vote"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1E88E5"/>

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vote on trip plans and preferences"
            android:textColor="#555555"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Top Tabs -->
    <HorizontalScrollView
        android:id="@+id/tabScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerSection">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <Button
                android:id="@+id/tabParticipants"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Participants"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#2196F3"
                android:backgroundTint="#FFFFFF"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/tabPolls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Polls"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2196F3"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/tabExpenses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expenses"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#2196F3"
                android:backgroundTint="#FFFFFF"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/tabDocs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Docs"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#2196F3"
                android:backgroundTint="#FFFFFF"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/tabItinerary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Itinerary"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#2196F3"
                android:backgroundTint="#FFFFFF"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Poll Section -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPolls"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/tabScroll"
        app:layout_constraintBottom_toTopOf="@id/btnViewResults"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <Button
        android:id="@+id/btnViewResults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Results"
        android:backgroundTint="#64B5F6"
        android:textColor="#FFFFFF"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"/>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:itemIconTint="@color/nav_item_selector"
        app:itemTextColor="@color/nav_item_selector"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
