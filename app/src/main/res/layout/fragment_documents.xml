<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- Header Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Title and subtitle on the left -->
        <LinearLayout
            android:id="@+id/textContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Documents"
                android:textColor="#1565C0"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upload anything here"
                android:textColor="#555555"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Upload button pinned to the right -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:icon="@drawable/ic_upload"
            app:iconTint="#FFFFFF"
            app:iconPadding="8dp"
            app:cornerRadius="18dp"
            app:backgroundTint="#1E88E5"
            android:elevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <HorizontalScrollView
        android:id="@+id/tabScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingVertical="8dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerSection">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <!-- Active and Inactive tabs improved -->
            <Button
                android:id="@+id/tabParticipants"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Participants"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#2196F3"
                android:backgroundTint="#FFFFFF"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="16dp"
                android:elevation="2dp"/>

            <Button
                android:id="@+id/tabPolls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Polls"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#2196F3"
                android:backgroundTint="#FFFFFF"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="16dp"
                android:elevation="2dp"/>

            <Button
                android:id="@+id/tabExpenses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expenses"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#2196F3"
                android:backgroundTint="#FFFFFF"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="16dp"
                android:elevation="2dp"/>

            <!-- Highlighted Active Tab -->
            <Button
                android:id="@+id/tabDocs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Docs"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1E88E5"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="16dp"
                android:elevation="3dp"/>

            <Button
                android:id="@+id/tabItinerary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Itinerary"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#2196F3"
                android:backgroundTint="#FFFFFF"
                android:paddingHorizontal="16dp"
                android:elevation="2dp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main ScrollView for Photos -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tabScroll"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Documents"
                android:textStyle="bold"
                android:textColor="#1E88E5"
                android:textSize="17sp"
                android:layout_marginVertical="12dp"/>

            <!-- Grid-style Image layout -->
            <GridLayout
                android:id="@+id/gridDocuments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="true"
                android:rowOrderPreserved="false">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sample_doc1"
                    android:background="@drawable/rounded_card_bg"
                    android:elevation="3dp"/>

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sample_doc2"
                    android:background="@drawable/rounded_card_bg"
                    android:elevation="3dp"/>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_columnSpan="2"
                    android:layout_marginVertical="8dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sample_doc3"
                    android:background="@drawable/rounded_card_bg"
                    android:elevation="4dp"/>

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sample_doc4"
                    android:background="@drawable/rounded_card_bg"
                    android:elevation="3dp"/>

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sample_doc5"
                    android:background="@drawable/rounded_card_bg"
                    android:elevation="3dp"/>
            </GridLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:itemIconTint="@color/nav_item_selector"
        app:itemTextColor="@color/nav_item_selector"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
