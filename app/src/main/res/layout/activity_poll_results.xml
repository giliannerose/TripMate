<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E3F2FD"
    tools:context=".PollResultsActivity">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Poll Results"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1E88E5"/>

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="See how everyone voted on your trip polls"
            android:textColor="#555555"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Top Tabs -->
    <HorizontalScrollView
        android:id="@+id/tabScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerSection">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <Button
                android:id="@+id/tabParticipants"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Participants"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#2196F3"
                android:backgroundTint="#FFFFFF"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/tabPolls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Polls"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2196F3"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/tabExpenses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expenses"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#2196F3"
                android:backgroundTint="#FFFFFF"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/tabDocs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Docs"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#2196F3"
                android:backgroundTint="#FFFFFF"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/tabItinerary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Itinerary"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#2196F3"
                android:backgroundTint="#FFFFFF"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Poll Results -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tabScroll"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Poll 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:backgroundTintMode="src_over"
                android:clipToOutline="true"
                android:layout_marginHorizontal="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="What's your favorite season?"
                    android:textStyle="bold"
                    android:textColor="#1E88E5"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp"/>

                <ProgressBar
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="56"
                    android:progressTint="#2196F3"
                    android:layout_marginBottom="4dp"/>
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Summer - 56%" android:textSize="13sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Votes: 20 | Poll closed on August 20, 2025"
                    android:textSize="12sp"
                    android:textColor="#555"
                    android:layout_marginTop="8dp"/>

                <Button
                    android:id="@+id/btnBackPolls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Back to Polls"
                    android:backgroundTint="#64B5F6"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>

            <!-- Poll 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:padding="16dp"
                android:layout_marginHorizontal="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Where should we go for our next trip?"
                    android:textStyle="bold"
                    android:textColor="#1E88E5"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp"/>

                <ProgressBar
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="75"
                    android:progressTint="#2196F3"
                    android:layout_marginBottom="4dp"/>
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Siargao - 75%" android:textSize="13sp"/>

                <ProgressBar
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="25"
                    android:progressTint="#90CAF9"
                    android:layout_marginBottom="4dp"/>
                <TextView  android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Boracay - 25%" android:textSize="13sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Votes: 20 | Poll closed on August 20, 2025"
                    android:textSize="12sp"
                    android:textColor="#555"
                    android:layout_marginTop="8dp"/>

                <Button
                    android:id="@+id/btnBackPolls1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Back to Polls"
                    android:backgroundTint="#64B5F6"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:itemIconTint="@color/nav_item_selector"
        app:itemTextColor="@color/nav_item_selector"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
