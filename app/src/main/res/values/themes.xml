<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.TripMate" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">#2196F3</item>
        <item name="colorPrimaryContainer">#E3F2FD</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- Dialog styling -->
        <item name="alertDialogTheme">@style/TripMateDialogTheme</item>
    </style>

    <!-- Custom Dialog Style -->
    <style name="TripMateDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceSmallComponent">@style/RoundedDialogShape</item>
        <item name="colorPrimary">#2196F3</item>
    </style>

    <!-- Rounded Corners -->
    <style name="RoundedDialogShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>


</resources>
