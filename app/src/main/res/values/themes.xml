<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme -->
    <style name="Theme.TripMate" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color (main blue for buttons, icons, etc.) -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryVariant">@color/icon_blue</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary color (accent, e.g. for highlights or secondary buttons) -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/primary_blue</item>

        <!-- Background color for your app -->
        <item name="android:windowBackground">@color/background_blue</item>
        <item name="colorBackground">@color/background_blue</item>
        <item name="colorSurface">@color/card_white</item>
        <item name="colorOnSurface">@color/black</item>
    </style>

</resources>